{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hanmac:phase00:intake:0.1.0",
  "type": "object",
  "properties": {
    "entry_version": {
      "const": "0.1.0"
    },
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "byte_length",
        "role",
        "schema_version",
        "record_id",
        "record_version"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "invalid_json",
        "legacy_requires_mapping",
        "requires_version_review"
      ]
    },
    "missing_or_review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "automatic_fill_allowed": {
            "const": false
          }
        },
        "required": [
          "pointer",
          "reason",
          "automatic_fill_allowed"
        ],
        "additionalProperties": false
      }
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "source_unchanged": {
      "const": true
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "const": "copy_only_received"
          },
          "at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "event",
          "at_utc",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "analysis_search_allowed": {
      "const": false
    },
    "company_rule_search_allowed": {
      "const": false
    },
    "fact_verified": {
      "const": false
    },
    "company_approved": {
      "const": false
    },
    "operational_release": {
      "const": false
    }
  },
  "required": [
    "entry_version",
    "entry_id",
    "source",
    "status",
    "missing_or_review_items",
    "snapshot",
    "source_unchanged",
    "history",
    "analysis_search_allowed",
    "company_rule_search_allowed",
    "fact_verified",
    "company_approved",
    "operational_release"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "출처 목록",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_on": {
            "type": "string",
            "format": "date"
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "remote_snapshot_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_scope": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "url",
          "locator",
          "retrieved_on",
          "verification",
          "remote_snapshot_hash",
          "content_scope",
          "authority"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "sources"
  ],
  "additionalProperties": false
}

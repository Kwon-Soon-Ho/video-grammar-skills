    },
    {
      "loc": "slide[47]/p[2]",
      "text": "바론컨설턴트.",
      "kind": "slide_text"
    },
    {
      "loc": "slide[47]/p[3]",
      "text": "바론컨설턴트 페이드인",
      "kind": "slide_text"
    },

      "loc": "BodyText/Section0/record[1625]/para[259]",
      "text": "1) 진행일정",
      "kind": "body_paragraph",
      "level": 1
    },
    {
      "loc": "BodyText/Section0/record[1636]/para[260]",
      "text": "진행 순서",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1641]/para[261]",
      "text": "내 역",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1646]/para[262]",
      "text": "일 자",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1651]/para[263]",
      "text": "비 고",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1656]/para[264]",
      "text": "1.",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1661]/para[265]",
      "text": "MOU 체결",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1666]/para[266]",
      "text": "금액 잠정합의",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1671]/para[267]",
      "text": "‘26. 07. 02",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1680]/para[268]",
      "text": "2.",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1685]/para[269]",
      "text": "물적분할 업무진행",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1706]/para[270]",
      "text": "① 분할계획서 작성",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1711]/para[271]",
      "text": "자산.부채 분할/신설법인 정관",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1716]/para[272]",
      "text": "‘26. 07. 08",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1721]/para[273]",
      "text": "연대책임 배제",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1730]/para[274]",
      "text": "② 채권자 사전협의",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1735]/para[275]",
      "text": "발주처 및 채권자 분할협의",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1740]/para[276]",
      "text": "‘26.07.09. ~ 08.28",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1753]/para[277]",
      "text": "③ 임시주주총회",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1758]/para[278]",
      "text": "특별결의",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1763]/para[279]",
      "text": "‘26. 08. 28",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1776]/para[280]",
      "text": "④ 채권자보호절차",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1781]/para[281]",
      "text": "홈페이지 인터넷 공고",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1786]/para[282]",
      "text": "‘26. 08. 28. ~ 09.29",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1791]/para[283]",
      "text": "진행중",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1800]/para[284]",
      "text": "⑤ 개인정보이전",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1809]/para[285]",
      "text": "⑥ 분할기일",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1814]/para[286]",
      "text": "신설법인으로 자산 이전",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1819]/para[287]",
      "text": "‘26. 10. 01",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1824]/para[288]",
      "text": "법적효력 발생",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1833]/para[289]",
      "text": "⑦ 등기/사업자등록",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1838]/para[290]",
      "text": "본점소재지에 분할등기",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1843]/para[291]",
      "text": "‘26. 10. 23",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1852]/para[292]",
      "text": "3.",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1857]/para[293]",
      "text": "계약서 작성 및 날인",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1862]/para[294]",
      "text": "내역 검토 및 계약서 날인",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1867]/para[295]",
      "text": "‘26.09.04. ~ 09.23",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1872]/para[296]",
      "text": "진행중",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1877]/para[297]",
      "text": "대금수령(계약금 / 잔금)",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1882]/para[298]",
      "text": "계약금 : 26. 09. 23",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1887]/para[299]",
      "text": "잔금: 10/30일",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1891]/para[300]",
      "text": "2) 이슈사항",
      "kind": "body_paragraph",
      "level": 1
    },
    {
      "loc": "BodyText/Section0/record[1902]/para[301]",
      "text": "이슈사항",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1907]/para[302]",
      "text": "대응방안",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1912]/para[303]",
      "text": "1.",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1917]/para[304]",
      "text": "계약서 초안에 대한 이견",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1922]/para[305]",
      "text": "1차) 9/14일 양사의견을 피력함",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1931]/para[306]",
      "text": "1) 과거실적증명서를 신설법인 명의로 발행요청",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1936]/para[307]",
      "text": "“당사는 수용불가함”으로 삭제 요청",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1945]/para[308]",
      "text": "2) 매매대금에서 계약금(10~20%) 조항 삽입",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1950]/para[309]",
      "text": "당사의 요청으로 조정 가능함",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1959]/para[310]",
      "text": "3) 경업금지에 특수관계인 명기 여부",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1964]/para[311]",
      "text": "특수관계인(삼안)포함하되 소각으로 한정(협의가능)",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1973]/para[312]",
      "text": "4) 고용승계에 대한 이견",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1978]/para[313]",
      "text": "고용승계 문구로 조정",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1987]/para[314]",
      "text": "5) 민간사업(울산소각) 대수선비 비용부담",
      "kind": "body_paragraph",
      "level": 3
    },
    {
      "loc": "BodyText/Section0/record[1992]/para[315]",
      "text": "매수인 오해로 사업계획서 검토중임",
      "kind": "body_paragraph",
      "level": 3
    }
  ]
}

  "path": "한맥 영상/00_26년 가족사 경영보고 영상/00초기 기획서/경영현황 시나리오_한라산업개발_26.09.18.hwp",
  "sha256": "aa1ed2e77a3abf0abebb6c34e298561df7fdaa21b7b7eecb717ee387d108b4d6",
  "backup": false,
  "status": "text_extracted",
  "chunk_count": 31,
  "chars": 1621,
  "detail": {
    "scope": "HWP5 paragraph text records only; layout, drawing objects and complex table interpretation not rendered",
    "flags": 1,
    "sections": [
      {
        "name": "BodyText/Section0",
        "records": 165,
